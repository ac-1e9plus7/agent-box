          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string",
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "metric_explain",
    "description": "Explain an authorized published metric in a dataset context.",
    "operationId": "agentMetricExplain",
    "auditToolName": "metric.explain",
    "scope": "agent.catalog.read",
    "execution": false,
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["datasetId", "metricId"],
      "properties": {
        "datasetId": {
          "type": "integer",
          "minimum": 1
        },
        "metricId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "access_explain",
    "description": "Explain effective access for a governed dataset and optional semantic query.",
    "operationId": "agentAccessExplain",
    "auditToolName": "access.explain",
    "scope": "agent.access.explain",
    "execution": false,
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "query": {
          "type": "object",
          "required": ["datasetId", "select"],
          "properties": {
            "datasetId": {
              "type": "integer",
              "minimum": 1
            },
            "select": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "$ref": "#/$defs/selectItem"
              }
            },
            "filters": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/filter"
              }
            },
            "orderBy": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/orderBy"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "periodComparison": {
              "$ref": "#/$defs/periodComparison"
            }
          },
          "additionalProperties": false
        },
        "selectItem": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["METRIC", "DIMENSION"]
            },
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "alias": {
              "type": "string",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        "filter": {
          "type": "object",
          "required": ["dimensionId", "operator", "values"],
          "properties": {
            "dimensionId": {
              "type": "integer",
              "minimum": 1
            },
            "operator": {
              "type": "string",
              "enum": ["EQ", "NEQ", "IN", "NOT_IN", "BETWEEN", "GT", "GTE", "LT", "LTE", "LIKE"]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            }
          },
          "additionalProperties": false
        },
        "orderBy": {
          "type": "object",
          "required": ["metricId", "direction"],
          "properties": {
            "metricId": {
              "type": "integer",
              "minimum": 1
            },
            "direction": {
              "type": "string",
              "enum": ["ASC", "DESC"]
            }
          },
          "additionalProperties": false
        },
        "periodComparison": {
          "type": "object",
          "required": ["type", "metricIds"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["YOY", "WOW", "MOM"]
            },
            "metricIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "type": "object",
      "required": ["resource"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["QUERY_EXECUTE"]
        },
        "resource": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["DATASET"]
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "query": {
          "$ref": "#/$defs/query"
        }
      },
      "additionalProperties": false
    }
  },
