[
  {
    "name": "catalog_search",
    "description": "Search semantic assets authorized for the current user.",
    "operationId": "agentCatalogSearch",
    "auditToolName": "catalog.search",
    "scope": "agent.catalog.read",
    "execution": false,
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "assetTypes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["DATASET", "METRIC", "DIMENSION", "REPORT"]
          }
        },
        "datasetIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
