{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/electron/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
